# Google Ads API Credentials
# Copy this file to .env and fill in your values

GOOGLE_ADS_DEVELOPER_TOKEN=YOUR_DEVELOPER_TOKEN
GOOGLE_ADS_CLIENT_ID=YOUR_OAUTH2_CLIENT_ID
GOOGLE_ADS_CLIENT_SECRET=YOUR_OAUTH2_CLIENT_SECRET
GOOGLE_ADS_REFRESH_TOKEN=YOUR_REFRESH_TOKEN
GOOGLE_ADS_LOGIN_CUSTOMER_ID=YOUR_MCC_CUSTOMER_ID

# Optional: Path to google-ads.yaml (defaults to config/google-ads.yaml)
GOOGLE_ADS_YAML_PATH=config/google-ads.yaml

# Application Settings
DEFAULT_DATE_RANGE_DAYS=30
COST_THRESHOLD_USD=5.0
SPEND_THRESHOLD_FOR_NEGATIVE=10.0
MIN_CLICKS_FOR_OPPORTUNITY=5
LOW_QS_THRESHOLD=5
BUDGET_LOST_IS_THRESHOLD=0.1

# SQLite log database path
CHANGES_LOG_DB=changes_log.db

# Logging
LOG_LEVEL=INFO
