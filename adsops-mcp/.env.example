# --- Google Ads OAuth (used by auth.py; the server reads google-ads.yaml) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_YAML=google-ads.yaml
# GOOGLE_ADS_API_VERSION=v26

# --- adsops ---
# ADSOPS_CONFIG=config.yaml
# ADSOPS_DB=data/adsops.db
# ADSOPS_REPORTS_DIR=data/reports
ADSOPS_DRY_RUN=false
# Ask the human through MCP elicitation inside apply_proposal (if the client supports it)
ADSOPS_REQUIRE_ELICITATION=false

# --- HTTP transport (python server.py --transport http) ---
# Long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
ADSOPS_HTTP_TOKEN=
ADSOPS_HTTP_HOST=127.0.0.1
ADSOPS_HTTP_PORT=8765
ADSOPS_HTTP_PATH=/mcp

# --- monitor.py -> Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
